    {
      "id": "selected",
      "lane": "stores",
      "col": 3,
      "type": "database",
      "label": "Selected stores",
      "sublabel": "50 kB metadata each",
      "width": 150
    },
    {
      "id": "celltable",
      "lane": "stores",
      "col": 4,
      "type": "database",
      "label": "Cell table, X bands",
      "sublabel": "index skips chunks",
      "width": 150
    },
    {
      "id": "dup",
      "lane": "refused",
      "col": 0,
      "type": "security",
      "label": "Duplicate dataset",
      "sublabel": "collision named",
      "width": 150
    },
    {
      "id": "incompat",
      "lane": "refused",
      "col": 2,
      "type": "security",
      "label": "Incompatible",
      "sublabel": "versions named",
      "width": 150
    },
    {
      "id": "unreachable",
      "lane": "refused",
      "col": 3,
      "type": "security",
      "label": "Unreachable store",
      "sublabel": "source named",
      "width": 150
    }
  ],
  "edges": [
    {
      "from": "resolve",
      "to": "prune"
    },
    {
      "from": "prune",
      "to": "check"
    },
    {
      "from": "check",
      "to": "open",
      "label": "stores that can match",
      "variant": "emphasis"
    },
    {
      "from": "open",
      "to": "read"
    },
    {
      "from": "read",
      "to": "concat"
    },
    {
      "from": "catalog",
      "to": "prune",
      "label": "read",
      "role": "branch"
    },
    {
      "from": "open",
      "to": "selected",
      "label": "open",
      "role": "branch"
    },
    {
      "from": "read",
      "to": "celltable",
      "label": "fetch",
      "role": "branch"
    },
    {
      "from": "resolve",
      "to": "dup",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "check",
      "to": "incompat",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "selected",
      "to": "unreachable",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Prune before open",
      "items": [
        "The catalog excludes whole datasets",
        "The per-chunk index excludes chunks inside each open store",
        "A one-dataset query reads 2.6 percent of cell-table chunks"
      ]
    },
    {
      "dot": "emerald",
      "title": "Access",
      "items": [
        "Public stores open with anonymous reads",
        "A private store opens with the caller's credentials",
        "Object storage enforces the grant"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusals",
      "items": [
        "A dataset_id in two sources",
        "Stores with different gene references",
        "A store the caller cannot reach"
      ]
    }
  ]
}
