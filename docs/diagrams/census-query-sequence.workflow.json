{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Census 2 query sequence",
    "output": "census-query-sequence.html",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "SDK entry and result"
        },
        "backend": {
          "label": "SDK step"
        },
        "security": {
          "label": "Refusal"
        },
        "database": {
          "label": "Stored object"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "sdk",
      "label": "SDK, on the user's machine"
    },
    {
      "id": "census",
      "label": "Census prefix"
    },
    {
      "id": "stores",
      "label": "Dataset stores, public and private buckets"
    },
    {
      "id": "refused",
      "label": "Query refused",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "plan",
      "label": "Plan from metadata",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "read",
      "label": "Object reads only",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "result",
      "label": "Result",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "resolve",
    "prune",
    "check",
    "open",
    "read",
    "concat"
  ],
  "nodes": [
    {
      "id": "resolve",
      "lane": "sdk",
      "col": 0,
      "type": "frontend",
      "label": "Resolve sources",
      "sublabel": "catalogs, manifests",
      "width": 150
    },
    {
      "id": "prune",
      "lane": "sdk",
      "col": 1,
      "type": "backend",
      "label": "Prune datasets",
      "sublabel": "bitmaps and ranges",
      "width": 150
    },
    {
      "id": "check",
      "lane": "sdk",
      "col": 2,
      "type": "backend",
      "label": "Check compatibility",
      "sublabel": "organism, gene reference",
      "tag": "gate",
      "width": 150
    },
    {
      "id": "open",
      "lane": "sdk",
      "col": 3,
      "type": "backend",
      "label": "Open stores",
      "sublabel": "anonymous or by grant",
      "width": 150
    },
    {
      "id": "read",
      "lane": "sdk",
      "col": 4,
      "type": "backend",
      "label": "Read in store",
      "sublabel": "index and gene bands",
      "width": 150
    },
    {
      "id": "concat",
      "lane": "sdk",
      "col": 5,
      "type": "frontend",
      "label": "Concatenate",
      "sublabel": "one AnnData",
      "width": 150
