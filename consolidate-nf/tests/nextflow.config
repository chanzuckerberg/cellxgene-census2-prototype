// Config applied to every nf-test run.
//
// The stores and the plan are not tracked. Write them once with
// `tools/seed-stores.py tests/stores`, in the runtime image, as CI does. The plan
// names the stores by local path, which a task container sees only through a
// mount, so the mount is here.
params {
    plan = "${projectDir}/tests/stores/plan.jsonl"
}

docker.runOptions = "-u \$(id -u):\$(id -g) -e HOME=/tmp" +
                    " -v ${projectDir}/tests/stores:${projectDir}/tests/stores:ro"
