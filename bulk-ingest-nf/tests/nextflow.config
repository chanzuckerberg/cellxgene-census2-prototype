// Config applied to every nf-test run.
//
// Tests read a pinned manifest from tests/fixtures. They do not query the
// Discover API, so a run is reproducible, and the validation tests run offline.
//
// The gene references are not tracked, and every test needs them, because the
// pipeline checks that `refdata` exists before it starts a task. Stage them once
// with `tools/stage-refdata.py tests/refdata`, as CI does.
params {
    manifest = "${projectDir}/tests/fixtures/manifest.jsonl"
    refdata  = "${projectDir}/tests/refdata"
}
