// Portable Nextflow. Keep platform specifics in conf/<profile>.config.

nextflow.enable.moduleBinaries = true

manifest {
    name            = 'census2-bulk-ingest'
    description     = 'Ingest CELLxGENE Discover datasets into AnnData-Zarr stores'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04'
    version         = '0.1.0'
}

params {
    // Input. Prepare it with tools/cxg-manifest.py, which runs outside the pipeline.
    // A local path or an s3:// URI. Required.
    manifest = null

    // Conversion
    outdir    = './out'           // local path or s3:// prefix
    container = null              // override the profile's default image

    // Where the run report is published, which is not `outdir`: the report is
    // about a run, not about a store. A profile sets it, and it is unset here,
    // so a local run leaves the report in the task's working directory.
    report_dir = null

    // Set by execution profiles whose workers cannot reach this filesystem.
    remote_outdir_required = false
    // Set by execution profiles that cannot pull a public image.
    container_required     = false
    all_slots = false             // false means the Census slot set
    config    = null              // ingestion configuration file, staged into each task
    refdata   = null              // required: directory of gene references, from tools/stage-refdata.py
    check     = false             // round-trip verify each dataset

    // Resources
    max_memory = '128.GB'
    max_cpus   = 8
    tracedir   = './reports'
}

includeConfig 'conf/base.config'

profiles {
    docker      { includeConfig 'conf/docker.config'      }
    healthomics { includeConfig 'conf/healthomics.config' }
}

// Execution reports are cheap. A store is never copied: Nextflow moves it for a
// local destination, and the task writes it for a remote one.
timeline { enabled = true; file = "${params.tracedir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/trace.txt";     overwrite = true }
