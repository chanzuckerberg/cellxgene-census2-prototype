// Run tasks locally in the runtime image.

process {
    executor  = 'local'
    container = params.container ?: 'census2-bulk-ingest:dev'
}

// Bound concurrent ingests so we do not saturate the machine or the S3
// connection. Raise on a bigger host.
executor {
    name      = 'local'
    queueSize = 4
}

// Credentials reach the container as environment variables. Nothing is mounted.
// Make sure real credentials are present in the launching environment; see
// README.md.
//
// `-e NAME` passes the value through and omits the variable when the launcher
// does not have it. Setting it in the `env` scope instead would export an empty
// value, and Nextflow warns once per empty variable.
docker {
    enabled    = true
    runOptions = "-u \$(id -u):\$(id -g) -e HOME=/tmp" +
                 " -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN" +
                 " -e AWS_ENDPOINT_URL"
}

// A region always has a value, so these stay here.
env {
    AWS_REGION         = System.getenv('AWS_REGION') ?: 'us-west-2'
    AWS_DEFAULT_REGION = System.getenv('AWS_REGION') ?: 'us-west-2'
}
