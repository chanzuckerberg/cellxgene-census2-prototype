// Generic resource policy. Per-dataset sizing lives in the INGEST process,
// where the manifest record is in scope.

process {
    cpus   = 1
    memory = 4.GB

    // Retry on out-of-memory and on transient transfer failures. Each attempt
    // raises the memory request; see the INGEST process.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247, 255] ? 'retry' : 'finish' }
    maxRetries    = 3

    withLabel: small {
        cpus   = 1
        memory = 2.GB
    }

    // A run of thousands of datasets meets transient failures that no exit
    // code identifies, such as a download that exits 1. So any failure gets
    // one retry, and the codes above get up to maxRetries. After that the task
    // is ignored: the run continues, and REPORT reads the receipts that exist.
    // An ignored dataset has no receipt. REPORT keeps the default above, so a
    // failed check still fails the run.
    withLabel: ingest {
        cpus = Math.min(2, params.max_cpus as int)
        errorStrategy = {
            (task.exitStatus in [104, 134, 137, 139, 143, 247, 255] || task.attempt == 1) && task.attempt <= task.maxRetries
                ? 'retry' : 'ignore'
        }
    }
}
