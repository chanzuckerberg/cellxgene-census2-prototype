// Generic resource policy. Per-dataset sizing lives in the INGEST process,
// where the manifest record is in scope.

process {
    cpus   = 1
    memory = 4.GB

    // Retry on out-of-memory and on transient transfer failures. Each attempt
    // raises the memory request; see the INGEST process.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247, 255] ? 'retry' : 'finish' }
    maxRetries    = 3

    withLabel: small {
        cpus   = 1
        memory = 2.GB
    }

    withLabel: ingest {
        cpus = Math.min(2, params.max_cpus as int)
    }
}
