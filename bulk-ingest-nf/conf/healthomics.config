// AWS HealthOmics.
//
// The pipeline needs no public internet access. `tools/cxg-manifest.py` runs
// outside the pipeline and writes the manifest to S3, so every task reads only
// from S3. No VPC and no NAT gateway are required.
//
// Constraints that shape this file:
//   - Container images must be private ECR URIs. Public registries are not supported.
//   - ARM images are not supported. Build linux/amd64.
//   - The run role needs read access to the source bucket and to the manifest,
//     plus write access to --outdir. HealthOmics supplies those credentials to
//     each task, so nothing needs to be passed in the environment.

// A HealthOmics worker does not share the submitting filesystem, so a local
// --outdir cannot be published. main.nf refuses that combination.
params.remote_outdir_required = true

// HealthOmics exports what a run writes to this directory, and only this
// directory, to the run output location given to StartRun.
params.report_dir = '/mnt/workflow/pubdir'

// Nextflow's own execution reports would go beside the ingestion report.
// HealthOmics runs have not published them, and the cause is not known; the run
// manifest log records the task metrics instead (see CLAUDE.md). Set here and
// not in nextflow.config, because a params override is applied after that file
// is evaluated, and these paths are read while it is.
timeline.file = "${params.report_dir}/timeline.html"
report.file = "${params.report_dir}/report.html"
trace.file = "${params.report_dir}/trace.txt"

// There is no usable default: the image must be a private ECR URI in this
// region. main.nf refuses the run rather than failing later on an image pull.
params.container_required = true

process {
    container = params.container
}

aws.region = 'us-west-2'
