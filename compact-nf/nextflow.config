// Portable Nextflow. Keep platform specifics in conf/<profile>.config.

nextflow.enable.moduleBinaries = true

manifest {
    name            = 'census2-compact'
    description     = 'Compact small Census 2 stores into one AnnData-Zarr store per group'
    mainScript      = 'main.nf'
    // An exact version, as in bulk-ingest-nf: HealthOmics then runs this version.
    nextflowVersion = '25.10.0'
    version         = '0.1.0'
}

params {
    // Input. Prepare it with tools/compaction-plan.py, which runs outside the
    // pipeline. A local path or an s3:// URI. Required.
    plan = null

    outdir    = './out'           // local path or s3:// prefix for the compacted stores
    container = null              // override the profile's default image
    check     = false             // compare each compacted store with its members

    // Where the run report is published; see bulk-ingest-nf.
    report_dir = null

    // Set by execution profiles whose workers cannot reach this filesystem.
    remote_outdir_required = false
    // Set by execution profiles that cannot pull a public image.
    container_required     = false

    max_memory = '64.GB'
    max_cpus   = 4
    tracedir   = './reports'
}

includeConfig 'conf/base.config'

profiles {
    docker      { includeConfig 'conf/docker.config'      }
    healthomics { includeConfig 'conf/healthomics.config' }
}

timeline { enabled = true; file = "${params.tracedir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/trace.txt";     overwrite = true }
