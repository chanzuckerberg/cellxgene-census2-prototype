nextflow_pipeline {

    name "compaction"
    script "../../main.nf"

    test("compacts one group and checks every member") {
        // The stores come from tools/seed-stores.py; see tests/nextflow.config.
        tag "compact"

        when {
            params {
                outdir = "$outputDir/out"
                check  = true
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.succeeded().size() == 2
            def receipt = new groovy.json.JsonSlurper().parse(file("$outputDir/out/c-test.json"))
            assert receipt.check.passed
            assert receipt.n_members == 3
            assert receipt.n_obs == 125
            assert receipt.members == ["version-0", "version-1", "version-2"]
            assert file("$outputDir/out/c-test.zarr/zarr.json").exists()
        }
    }
}
