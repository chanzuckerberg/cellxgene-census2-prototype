// Run tasks locally in the runtime image of bulk-ingest-nf, which holds the
// census2-dataset-writer package and thus its compaction module.

process {
    executor  = 'local'
    container = params.container ?: 'census2-bulk-ingest:dev'
}

executor {
    name      = 'local'
    queueSize = 4
}

// Credentials reach the container as environment variables; see bulk-ingest-nf.
docker {
    enabled    = true
    runOptions = "-u \$(id -u):\$(id -g) -e HOME=/tmp" +
                 " -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN" +
                 " -e AWS_ENDPOINT_URL"
}

env {
    AWS_REGION         = System.getenv('AWS_REGION') ?: 'us-west-2'
    AWS_DEFAULT_REGION = System.getenv('AWS_REGION') ?: 'us-west-2'
}
