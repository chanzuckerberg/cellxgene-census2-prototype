// Generic resource policy. Per-group sizing lives in the COMPACT process, where the
// plan record is in scope.

process {
    cpus   = 1
    memory = 4.GB

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247, 255] ? 'retry' : 'finish' }
    maxRetries    = 3

    withLabel: small {
        cpus   = 1
        memory = 2.GB
    }

    // As INGEST in bulk-ingest-nf: any failure gets one retry, and an
    // out-of-memory code up to maxRetries. After that the task is ignored. A group
    // that fails is not compacted, and its datasets stay in their per-dataset
    // stores, so the run continues. REPORT keeps the default above, so a failed
    // check still fails the run.
    withLabel: compact {
        cpus = Math.min(2, params.max_cpus as int)
        errorStrategy = {
            (task.exitStatus in [104, 134, 137, 139, 143, 247, 255] || task.attempt == 1) && task.attempt <= task.maxRetries
                ? 'retry' : 'ignore'
        }
    }
}
