// AWS HealthOmics. The constraints are those of bulk-ingest-nf/conf/healthomics.config:
// a private ECR image for linux/amd64, a remote --outdir, and a run role that reads
// the per-dataset stores and writes --outdir.

params.remote_outdir_required = true
params.container_required     = true

// HealthOmics exports the files that a task publishes here to the pubdir/ prefix
// of the run output location.
params.report_dir = '/mnt/workflow/pubdir'

// HealthOmics exports the engine's own files from /mnt/workflow/output/ only.
timeline.file = '/mnt/workflow/output/timeline.html'
report.file   = '/mnt/workflow/output/report.html'
trace.file    = '/mnt/workflow/output/trace.txt'

process {
    container = params.container
}

aws.region = 'us-west-2'
